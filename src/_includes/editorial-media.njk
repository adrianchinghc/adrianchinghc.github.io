{% from "icons.njk" import icon %}
{% set lead = media.featuredVideos[0] %}
<div class="editorial-feature"><a class="video-card" href="{{ lead.url }}" target="_blank" rel="noopener" data-analytics-event="youtube_click" aria-label="Watch {{ lead.title }} on YouTube (opens in a new tab)"><div class="video-thumbnail"><img src="{{ lead.homeImage }}" data-mobile-crop="16/10" data-mobile-position="46" alt="" width="{{ lead.homeWidth }}" height="{{ lead.homeHeight }}" loading="lazy" decoding="async"><span class="video-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span></div></a><div><p class="content-topic">{{ lead.topic }}</p><h3>{{ lead.question }}</h3><p>{{ lead.context }}</p><p class="published-title">{{ lead.title }}</p><div class="idea-action"><a class="text-link" href="{{ lead.url }}" target="_blank" rel="noopener" data-analytics-event="youtube_click">Watch on YouTube<span class="sr-only">: {{ lead.title }} (opens in a new tab)</span>{{ icon("external", "link-arrow") }}</a><span class="content-meta">{{ lead.views }}</span></div></div></div>
<div class="media-supporting">{% for video in media.featuredVideos %}{% if not loop.first %}<a class="video-card" href="{{ video.url }}" target="_blank" rel="noopener" data-analytics-event="youtube_click" aria-label="Watch {{ video.title }} on YouTube (opens in a new tab)"><div class="video-thumbnail"><img src="{{ video.homeImage }}" data-mobile-crop="16/9" data-mobile-position="46" alt="" width="{{ video.homeWidth }}" height="{{ video.homeHeight }}" loading="lazy" decoding="async"><span class="video-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span></div><div><p class="content-topic">{{ video.topic }}</p><h3>{{ video.question }}</h3><p class="content-meta">{{ video.views }} · Watch on YouTube</p></div></a>{% endif %}{% endfor %}</div>
