<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="Adrian Ching">
  <meta name="robots" content="{{ robots or 'index, follow' }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" type="image/png" href="/assets/images/logo.png">
  <link rel="apple-touch-icon" href="/assets/images/logo.png">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="Adrian Ching">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}Adrian Ching">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ image or '/assets/images/banners/default.png' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@adrianchinghc">
  <meta name="twitter:creator" content="@adrianchinghc">
  <meta name="twitter:title" content="{% if title %}{{ title }} · {% endif %}Adrian Ching">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ image or '/assets/images/banners/default.png' }}">
  <link rel="stylesheet" href="/assets/css/site.css">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Person","name":"Adrian Ching","url":"https://adrianching.com","image":"https://adrianching.com/assets/images/adrianching.jpg","jobTitle":"Founder","worksFor":{"@type":"Organization","name":"Second Team"},"sameAs":["{{ site.social.youtube }}","{{ site.social.x }}","{{ site.social.github }}"]}</script>
  {% block head %}{% endblock %}
  {% include "analytics.njk" %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="wordmark" href="/" aria-label="Adrian Ching, home"><span aria-hidden="true">AC</span><strong>Adrian Ching</strong></a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
        <a href="/work-with-me/">Work with me</a><a href="/blog/">Thinking</a><a href="/about/">About</a><a class="nav-cta" href="/newsletter/">Newsletter</a>
      </nav>
    </div>
  </header>
  <main id="main">{{ content | safe }}</main>
  <footer class="site-footer">
    <div class="shell footer-grid">
      <div><a class="footer-name" href="/">Adrian Ching</a><p>Building businesses in the AI era.</p></div>
      <nav aria-label="Footer navigation"><a href="/work-with-me/">Work with me</a><a href="/ai-profit-opportunity-audit/">AI Profit Opportunity Audit</a><a href="/advisory/">Private advisory</a><a href="/blog/">Thinking</a></nav>
      <div class="footer-connect"><a href="{{ site.social.youtube }}" rel="me noopener" target="_blank">YouTube</a><a href="{{ site.social.x }}" rel="me noopener" target="_blank">X</a><a href="{{ site.social.github }}" rel="me noopener" target="_blank">GitHub</a><a href="{{ site.contactUrl }}">Contact</a></div>
    </div>
    <div class="shell footer-bottom"><span>© {{ "now" | year }} Adrian Ching</span><span>Kuala Lumpur · Building globally</span></div>
  </footer>
  <script src="/assets/js/site.js" defer></script>
</body>
</html>
