<rect x="655" y="58" width="50" height="86" rx="4" fill="none" stroke="var(--line,#d8dad1)"/>
<text x="680" y="94" font-size="24" font-weight="700" text-anchor="middle" fill="currentColor">11</text>
<text x="680" y="121" font-size="12" text-anchor="middle" fill="currentColor">closed</text>
</g>

<path d="M115 144v46" stroke="var(--line,#d8dad1)"/>
<path d="M109 184l6 6 6-6" fill="none" stroke="var(--line,#d8dad1)"/>
<rect x="40" y="190" width="250" height="74" rx="4" fill="none" stroke="var(--line,#d8dad1)"/>
<text x="58" y="224" font-size="26" font-weight="700" fill="currentColor">71</text>
<text x="105" y="217" font-size="14" fill="currentColor">got one attempt</text>
<text x="105" y="239" font-size="14" fill="var(--muted,#5e6259)">and nothing after</text>

<path d="M228 300h405" stroke="var(--line,#d8dad1)"/>
<path d="M228 292v16M633 292v16" stroke="var(--line,#d8dad1)"/>
