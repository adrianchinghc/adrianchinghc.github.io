<text x="246" y="121" font-size="14" fill="currentColor">quotes sent</text>

<path d="M378 101h142" stroke="var(--signal,#a53b29)" stroke-width="3" stroke-dasharray="7 7"/>
<path d="M514 94l7 7-7 7" fill="none" stroke="var(--signal,#a53b29)" stroke-width="2"/>
<text x="449" y="82" font-size="13" font-weight="700" text-anchor="middle" fill="var(--signal,#a53b29)">FOLLOW-UP LEAK</text>
