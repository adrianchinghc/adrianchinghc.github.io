<text x="58" y="118" font-size="14" fill="currentColor">enquiries</text>
<text x="58" y="136" font-size="12" fill="var(--muted,#5e6259)">in 90 days</text>

<path d="M190 101h38" stroke="var(--line,#d8dad1)"/>
<path d="M222 95l6 6-6 6" fill="none" stroke="var(--line,#d8dad1)"/>

