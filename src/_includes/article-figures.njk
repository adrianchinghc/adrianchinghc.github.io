<rect x="521" y="58" width="112" height="86" rx="4" fill="none" stroke="var(--signal,#a53b29)" stroke-width="2"/>
<text x="539" y="94" font-size="30" font-weight="700" fill="var(--signal,#a53b29)">18</text>
<text x="539" y="121" font-size="14" fill="currentColor">chased</text>

